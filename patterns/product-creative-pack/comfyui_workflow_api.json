{
  "_note": "Non-executed mock-mode ComfyUI API placeholder. Do not send this to a live server during Tranche 8.",
  "workflow_mode": "mock_placeholder",
  "execution_allowed": false,
  "requires_human_approval_before_live_use": true,
  "controllable_parameters": {
    "positive_prompt": "{{prompt_pack[].positive_prompt}}",
    "negative_prompt": "{{prompt_pack[].negative_prompt}}",
    "aspect_ratio": "{{prompt_pack[].aspect_ratio}}",
    "seed": "{{comfyui_job_manifest.jobs[].seed}}",
    "steps": 28,
    "cfg_scale": 6.5,
    "sampler": "dpmpp_2m_sde",
    "scheduler": "karras",
    "source_image_refs": "{{normalized_brief.source_images}}"
  },
  "nodes": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "human-selected-model.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{positive_prompt}}",
        "clip": ["1", 1]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative_prompt}}",
        "clip": ["1", 1]
      }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "derived_from_aspect_ratio",
        "height": "derived_from_aspect_ratio",
        "batch_size": 1
      }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg_scale}}",
        "sampler_name": "{{sampler}}",
        "scheduler": "{{scheduler}}",
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      }
    },
    "6": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "human_approved_product_creative_pack",
        "images": ["5", 0]
      }
    }
  }
}
