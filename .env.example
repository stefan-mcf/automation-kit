# Automation Kit Environment Configuration
# Copy to .env for local overrides; never commit .env

# Set to "true" to enable real external-service/API calls (requires explicit human approval)
AUTO_KIT_USE_LIVE_SERVICES=false

# Optional ComfyUI live boundary; keep empty for mock-first evidence tests
COMFYUI_BASE_URL=
COMFY_CLOUD_API_KEY=

# Mock data seed (change to vary deterministic test data)
AUTO_KIT_MOCK_SEED=42
